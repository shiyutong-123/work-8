+def _sanitize_query(data: dict[str, str]) -> str:
+    if not isinstance(data, dict):
+        raise TypeError("data must be a dict with a 'raw' string value")
+    raw = data.get("raw")
+    if not isinstance(raw, str):
+        raise TypeError("data must be a dict with a 'raw' string value")
+    return raw.replace("\x00", "").strip()
